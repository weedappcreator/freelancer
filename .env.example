# Freelance Revenue OS — Environment Variables
# Copy to .env and fill in your values. NEVER commit .env

# ═══════════════════════════════════════════════
# LLM PROVIDERS (configure at least one)
# ═══════════════════════════════════════════════

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenRouter (multi-model gateway)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4-20250514
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI-compatible (for opencode, local models, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# opencode CLI (free models, zero cost — shells out to the opencode binary)
# No API key needed. Binary resolved via `which opencode`, else /Users/macbookpro/.opencode/bin/opencode
OPENCODE_MODEL=opencode/big-pickle

# Default provider: anthropic | openrouter | openai | ollama | opencode
LLM_PROVIDER=anthropic

# ═══════════════════════════════════════════════
# CRM
# ═══════════════════════════════════════════════
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# ═══════════════════════════════════════════════
# EMAIL
# ═══════════════════════════════════════════════
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ═══════════════════════════════════════════════
# DASHBOARD
# ═══════════════════════════════════════════════
DASHBOARD_PORT=3000
DASHBOARD_SECRET=

# ═══════════════════════════════════════════════
# SYSTEM
# ═══════════════════════════════════════════════
NODE_ENV=development
LOG_LEVEL=info
DB_PATH=./data/freelance-revenue-os.db
APPROVAL_LEVEL=1
